# Скопируй в .env и заполни. .env не попадает в git.

# Токен бота от @BotFather (вид 123456789:AA...)
TELEGRAM_BOT_TOKEN=
# Твой числовой Telegram ID (узнать: @userinfobot). Бот отвечает только этому человеку.
TELEGRAM_OWNER_ID=

# Голосовые, вариант 1 (рекомендуется): ключ OpenAI, platform.openai.com → API keys.
# Это только для расшифровки голоса. Claude работает по подписке: ключи Anthropic сюда не пиши.
OPENAI_API_KEY=

# Голосовые, вариант 2 (бесплатно, локально): заполняется командой `bash scripts/install-local-stt.sh`.
# LOCAL_STT_CLI=/home/USER/.local/share/whisper.cpp/bin/parakeet-cli
# LOCAL_STT_MODEL=/home/USER/.local/share/whisper.cpp/models/ggml-parakeet-tdt-0.6b-v3-q8_0.bin

# Папка, где Claude работает по умолчанию (сообщение в общий чат начинает чат здесь).
# Пусто — первая папка из projects.json, а без него — домашняя папка.
DEFAULT_PROJECT=

# Файлы больше 20 МБ: ключи приложения с https://my.telegram.org → API development tools.
# `bash scripts/install-local-bot-api.sh` переносит их в отдельный файл и сам вписывает TELEGRAM_API_BASE.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# TELEGRAM_API_BASE=http://127.0.0.1:8081

# --- Необязательно ---
# Где бот хранит свою базу и полученные файлы (по умолчанию ~/.claude-telegram)
# CLAUDE_TELEGRAM_DATA=
# Путь к claude, если его нет в PATH
# CLAUDE_BIN=
